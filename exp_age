def remove_outliers_robust(df_column, method='iqr', threshold=1.5):

    data = df_column.dropna().values
    
    if method == 'iqr':
        # IQR 
        Q1 = np.percentile(data, 25)
        Q3 = np.percentile(data, 75)
        IQR = Q3 - Q1
        lower_bound = Q1 - threshold * IQR
        upper_bound = Q3 + threshold * IQR
        mask = (df_column >= lower_bound) & (df_column <= upper_bound)
        
    elif method == 'zscore':
        # Z 
        z_scores = np.abs((data - np.mean(data)) / np.std(data))

        data_mean = np.mean(data)
        data_std = np.std(data)
        z_scores_full = np.abs((df_column.values - data_mean) / data_std)
        mask = z_scores_full <= threshold
    
    else:
        #  IQR
        Q1 = np.percentile(data, 25)
        Q3 = np.percentile(data, 75)
        IQR = Q3 - Q1
        lower_bound = Q1 - threshold * IQR
        upper_bound = Q3 + threshold * IQR
        mask = (df_column >= lower_bound) & (df_column <= upper_bound)
    
    return mask

def remove_curvature_outliers(x, y, method='residual', threshold=2.0):
    
    if len(x) < 4:
        return np.ones_like(x, dtype=bool)
    
   
    try:
        coeff = np.polyfit(x, y, 2)
        pred_func = np.poly1d(coeff)
        y_pred = pred_func(x)
        residuals = y - y_pred
        
        if method == 'residual':
            residual_std = np.std(residuals)
            mask = np.abs(residuals) <= threshold * residual_std
            
        elif method == 'leverage':
 
            X = np.column_stack([x**2, x, np.ones_like(x)])
            H = X @ np.linalg.inv(X.T @ X) @ X.T
            leverage = np.diag(H)
            mask = leverage <= threshold * np.mean(leverage)
            
        else:
 
            residual_std = np.std(residuals)
            mask = np.abs(residuals) <= threshold * residual_std
            
    except:
 
        return np.ones_like(x, dtype=bool)
    
    return mask

def clean_data_by_network(network_name, df, age_range=(50, 70), exponent_range=(0.2, 1.4)):
    
    cleaned_df = df.copy()
    
  
    age_mask = (cleaned_df['Age'] >= age_range[0]) & (cleaned_df['Age'] <= age_range[1])
    exp_mask = (cleaned_df[network_name] >= exponent_range[0]) & (cleaned_df[network_name] <= exponent_range[1])
    
 
    cleaned_df = cleaned_df[age_mask & exp_mask].copy()
    
 
    for condition in ['Eyes Closed', 'Eyes Open']:
        for group in ['Normal Hearing', 'Hearing Impaired']:
            mask = (cleaned_df['Condition'] == condition) & (cleaned_df['Group'] == group)
            subset = cleaned_df[mask]
            
            if len(subset) >= 5:  
                x = subset['Age'].values
                y = subset[network_name].values
                
 
                iqr_mask = remove_outliers_robust(subset[network_name], method='iqr', threshold=1.5)
                cleaned_subset = subset[iqr_mask]
                
                if len(cleaned_subset) >= 4:
 
                    x_clean = cleaned_subset['Age'].values
                    y_clean = cleaned_subset[network_name].values
                    residual_mask = remove_curvature_outliers(x_clean, y_clean, method='residual', threshold=2.5)
                    
 
                    to_remove = cleaned_subset[~residual_mask].index
                    cleaned_df = cleaned_df.drop(to_remove)
    
 
    group_counts = cleaned_df.groupby(['Condition', 'Group']).size()
    valid_groups = group_counts[group_counts >= 3].index
    
 
    valid_mask = cleaned_df.apply(
        lambda row: (row['Condition'], row['Group']) in valid_groups, axis=1
    )
    
    return cleaned_df[valid_mask].copy()

def bootstrap_ci(x, y, n_bootstrap=1000, ci_level=0.95):
 
    n_samples = len(x)
    bootstrap_predictions = []
    
    for _ in range(n_bootstrap):
 
        indices = np.random.choice(n_samples, n_samples, replace=True)
        x_boot = x[indices]
        y_boot = y[indices]
        
        try:
 
            coeff = np.polyfit(x_boot, y_boot, 2)
            pred_func = np.poly1d(coeff)
            
 
            x_range = np.linspace(x.min(), x.max(), 200)
            y_pred = pred_func(x_range)
            bootstrap_predictions.append(y_pred)
        except:
            continue
    
    if bootstrap_predictions:
        bootstrap_predictions = np.array(bootstrap_predictions)
 
        alpha = (1 - ci_level) / 2
        lower = np.percentile(bootstrap_predictions, alpha * 100, axis=0)
        upper = np.percentile(bootstrap_predictions, (1 - alpha) * 100, axis=0)
        return x_range, lower, upper
    
    return None, None, None

def perform_robust_statistical_tests(network_name, condition, df):
 
    normal_mask = (df['Group'] == 'Normal Hearing') & (df['Condition'] == condition)
    impaired_mask = (df['Group'] == 'Hearing Impaired') & (df['Condition'] == condition)
    
    normal_values = df[normal_mask][network_name].values
    impaired_values = df[impaired_mask][network_name].values
    normal_ages = df[normal_mask]['Age'].values
    impaired_ages = df[impaired_mask]['Age'].values
    
 
    if len(normal_values) < 4 or len(impaired_values) < 4:
        return {}
    
    results = {}
    
    # 1.  Mann-Whitney U 
    try:
        mw_stat, mw_p = stats.mannwhitneyu(normal_values, impaired_values, alternative='two-sided')
        results['MannWhitney_U'] = mw_stat
        results['MannWhitney_p'] = mw_p
    except:
        results['MannWhitney_U'] = np.nan
        results['MannWhitney_p'] = np.nan
    
    # 2.  
    try:
        age_mw_stat, age_mw_p = stats.mannwhitneyu(normal_ages, impaired_ages, alternative='two-sided')
        results['Age_MannWhitney_U'] = age_mw_stat
        results['Age_MannWhitney_p'] = age_mw_p
    except:
        results['Age_MannWhitney_U'] = np.nan
        results['Age_MannWhitney_p'] = np.nan
    
    # 3.  
    try:
        normal_coeff = np.polyfit(normal_ages, normal_values, 2)
        impaired_coeff = np.polyfit(impaired_ages, impaired_values, 2)
        
        results['Normal_a_coeff'] = normal_coeff[0]
        results['Normal_b_coeff'] = normal_coeff[1]
        results['Normal_c_coeff'] = normal_coeff[2]
        results['Impaired_a_coeff'] = impaired_coeff[0]
        results['Impaired_b_coeff'] = impaired_coeff[1]
        results['Impaired_c_coeff'] = impaired_coeff[2]
        results['a_coeff_diff'] = impaired_coeff[0] - normal_coeff[0]
        results['b_coeff_diff'] = impaired_coeff[1] - normal_coeff[1]
        
        # 4.  bootstrap 
        n_bootstrap = 2000
        normal_a_boot = []
        impaired_a_boot = []
        
        for _ in range(n_bootstrap):
            #  
            indices = np.random.choice(len(normal_ages), len(normal_ages), replace=True)
            try:
                coeff = np.polyfit(normal_ages[indices], normal_values[indices], 2)
                normal_a_boot.append(coeff[0])
            except:
                pass
            
            #  
            indices = np.random.choice(len(impaired_ages), len(impaired_ages), replace=True)
            try:
                coeff = np.polyfit(impaired_ages[indices], impaired_values[indices], 2)
                impaired_a_boot.append(coeff[0])
            except:
                pass
        
        if normal_a_boot and impaired_a_boot:
           
            a_diff_boot = np.array(impaired_a_boot) - np.array(normal_a_boot)
           
            a_p_value = 2 * min(
                np.mean(a_diff_boot <= 0),
                np.mean(a_diff_boot >= 0)
            )
            results['a_coeff_p'] = a_p_value
        else:
            results['a_coeff_p'] = np.nan
        
        # 5.  
        normal_pred = np.poly1d(normal_coeff)(normal_ages)
        impaired_pred = np.poly1d(impaired_coeff)(impaired_ages)
        
        normal_r2 = 1 - np.sum((normal_values - normal_pred)**2) / np.sum((normal_values - np.mean(normal_values))**2)
        impaired_r2 = 1 - np.sum((impaired_values - impaired_pred)**2) / np.sum((impaired_values - np.mean(impaired_values))**2)
        
        results['Normal_R2'] = normal_r2
        results['Impaired_R2'] = impaired_r2
        
        # 6.  
        normal_vertex = -normal_coeff[1] / (2 * normal_coeff[0]) if normal_coeff[0] != 0 else np.nan
        impaired_vertex = -impaired_coeff[1] / (2 * impaired_coeff[0]) if impaired_coeff[0] != 0 else np.nan
        
        results['Normal_vertex_age'] = normal_vertex
        results['Impaired_vertex_age'] = impaired_vertex
        
        # 7.  Spearman
        normal_rho, normal_spearman_p = stats.spearmanr(normal_ages, normal_values)
        impaired_rho, impaired_spearman_p = stats.spearmanr(impaired_ages, impaired_values)
        
        results['Normal_Spearman_rho'] = normal_rho
        results['Normal_Spearman_p'] = normal_spearman_p
        results['Impaired_Spearman_rho'] = impaired_rho
        results['Impaired_Spearman_p'] = impaired_spearman_p
        
    except Exception as e:
        print(f" : {e}")
        for key in ['Normal_a_coeff', 'Normal_b_coeff', 'Normal_c_coeff', 
                   'Impaired_a_coeff', 'Impaired_b_coeff', 'Impaired_c_coeff',
                   'a_coeff_diff', 'b_coeff_diff', 'a_coeff_p', 
                   'Normal_R2', 'Impaired_R2', 'Normal_vertex_age', 
                   'Impaired_vertex_age', 'Normal_Spearman_rho', 
                   'Normal_Spearman_p', 'Impaired_Spearman_rho', 
                   'Impaired_Spearman_p']:
            results[key] = np.nan
    
    results['Normal_n'] = len(normal_values)
    results['Impaired_n'] = len(impaired_values)
    
    return results

def format_p_value(p_value):
    
    if pd.isna(p_value):
        return "NA"
    if p_value < 0.001:
        return "p < 0.001"
    elif p_value < 0.01:
        return f"p = {p_value:.3f}"
    elif p_value < 0.05:
        return f"p = {p_value:.3f}"
    else:
        return f"p = {p_value:.3f}"

