            group_df = df_cleaned[mask].copy()
            
            if len(group_df) >= 3:
                ages = group_df['Age'].values
                values = group_df[network_name].values
                
             
                rho, spearman_p = stats.spearmanr(ages, values)
                
             
                try:
                    poly_coeff = np.polyfit(ages, values, 2)
