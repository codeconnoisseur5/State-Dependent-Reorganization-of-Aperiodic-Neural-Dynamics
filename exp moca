def remove_outliers_zscore(data, column, threshold=3):
 
    z_scores = np.abs(stats.zscore(data[column]))
    return data[z_scores < threshold]

def create_moca_style_figure(network_name, abbrev):
 
    fig, axes = plt.subplots(1, 2, figsize=(12, 5), dpi=300)
    fig.suptitle(f'{abbrev}: MoCA-related Differences in Aperiodic Exponent', 
                 fontsize=14, fontweight='bold', y=0.98)
    
 
    all_stats = []
    
    for ax_idx, condition in enumerate(['Eyes Closed', 'Eyes Open']):
        ax = axes[ax_idx]
        
 
        group_data = {}
        
        for group in ['Normal Hearing', 'Hearing Impaired']:
 
            mask = (df['Group'] == group) & (df['Condition'] == condition)
            group_df = df[mask].copy()
            
            if len(group_df) > 3:  
 
                group_df_clean = remove_outliers_zscore(group_df, network_name, threshold=3)
                
 
                if len(group_df_clean) > 3:
 
                    moca_scores = group_df_clean['MoCA'].values
                    values = group_df_clean[network_name].values
                    
 
                    slope, intercept, r_value, p_value, std_err = stats.linregress(moca_scores, values)
                    
 
                    rho, spearman_p = stats.spearmanr(moca_scores, values)
                    
 
                    all_stats.append({
                        'Network': abbrev,
                        'Condition': condition,
                        'Group': group,
                        'n': len(moca_scores),
                        'n_original': len(group_df),
                        'Linear_r': r_value,
                        'Linear_p': p_value,
                        'Spearman_rho': rho,
                        'Spearman_p': spearman_p,
                        'Slope': slope
                    })
 
                    moca_range = np.linspace(moca_scores.min(), moca_scores.max(), 100)
                    pred_values = intercept + slope * moca_range
                    
 
                    residuals = values - (intercept + slope * moca_scores)
                    stderr_pred = np.std(residuals) * np.sqrt(1/len(moca_scores) + 
                                                             (moca_range - np.mean(moca_scores))**2 / 
                                                             np.sum((moca_scores - np.mean(moca_scores))**2))
                    
 
                    z_value = 1.37  # 对于83% CI
                    ci_lower = pred_values - z_value * stderr_pred
                    ci_upper = pred_values + z_value * stderr_pred
                    
 
                    ax.fill_between(moca_range, ci_lower, ci_upper, 
                                   color=colors[group], alpha=0.15, linewidth=0)
                    
 
                    line_style = condition_styles[condition]['linestyle']
                    line_alpha = condition_styles[condition]['alpha']
                    ax.plot(moca_range, pred_values, 
                           color=colors[group], 
                           linestyle=line_style,
                           linewidth=2.5,
                           alpha=line_alpha,
                           label=f'{group.split()[0]} (n={len(moca_scores)})')
                    
 
                    ax.scatter(moca_scores, values, 
                              color=colors[group],
                              alpha=0.4,
                              s=40,
                              edgecolor=colors[group],
                              linewidth=0.5)
                    
 
                    group_data[group] = {
                        'moca_scores': moca_scores,
                        'values': values,
                        'pred': pred_values,
                        'moca_range': moca_range
                    }
        
 
        ax.set_xlabel('MoCA Score', fontsize=11, fontweight='bold')
        ax.set_ylabel('Aperiodic Exponent', fontsize=11, fontweight='bold')
        ax.set_title(f'{condition}', fontsize=12, fontweight='bold', pad=10)
        
 
        ax.set_xlim(20, 30)   
        ax.set_ylim(0.2, 1.4)   
        
 
        ax.grid(True, alpha=0.1, linestyle='-', linewidth=0.5)
        
 
        ax.legend(loc='upper right', frameon=True, fancybox=True, 
                 framealpha=0.9, edgecolor='lightgray')
        
 
        stats_text = f'Spearman ρ: '
        group_stats = [s for s in all_stats if s['Condition'] == condition]
        for stat in group_stats:
            group_short = stat['Group'].split()[0]
            rho_val = stat['Spearman_rho']
            p_val = stat['Spearman_p']
            p_star = '***' if p_val < 0.001 else '**' if p_val < 0.01 else '*' if p_val < 0.05 else ''
            stats_text += f'{group_short}={rho_val:.2f}{p_star}, '
        
 
        ax.text(0.05, 0.95, stats_text.rstrip(', '), 
               transform=ax.transAxes, fontsize=9,
               verticalalignment='top',
               bbox=dict(boxstyle='round,pad=0.3', facecolor='white', 
                        edgecolor='lightgray', alpha=0.8))
    
 
    plt.tight_layout(rect=[0, 0, 1, 0.95])
    
 
    save_path = os.path.join(save_folder, f'{abbrev}_moca_correlation.svg')
    plt.savefig(save_path, format='svg', facecolor='white', edgecolor='none')
    print(f" : {save_path}")
    
    plt.show()
    plt.close()
    
    return pd.DataFrame(all_stats)

 
